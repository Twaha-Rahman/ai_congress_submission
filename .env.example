# Meridian demo environment configuration (non-secret template).
# Copy to .env and fill in values. .env is git-ignored.

# ---------------------------------------------------------------- tenant / office
TENANT_ID=meridian_demo

# ------------------------------------------------------------------- Dhaka office
DHAKA_DB_PATH=runtime/dhaka/meridian.db
DHAKA_SOURCE_DIR=runtime/dhaka/sources
DHAKA_KEY_DIR=runtime/keys/dhaka
DHAKA_REGION=DHAKA
DHAKA_LLM_BASE_URL=https://openrouter.ai/api/v1
DHAKA_LLM_MODEL=
DHAKA_LLM_API_KEY=
DHAKA_LLM_PROVIDER_PREFS=only=deepseek,cloudflare,order=deepseek,cloudflare,require_parameters=true

# --------------------------------------------------------------- Frankfurt office
FRANKFURT_DB_PATH=runtime/frankfurt/meridian.db
FRANKFURT_SOURCE_DIR=runtime/frankfurt/sources
FRANKFURT_KEY_DIR=runtime/keys/frankfurt
FRANKFURT_REGION=FRANKFURT
FRANKFURT_LLM_BASE_URL=https://openrouter.ai/api/v1
FRANKFURT_LLM_MODEL=
FRANKFURT_LLM_API_KEY=
FRANKFURT_LLM_PROVIDER_PREFS=only=deepseek,cloudflare,order=deepseek,cloudflare,require_parameters=true

# --------------------------------------------------------------------- model usage
# Model id used by BOTH offices for extraction/phrasing when the per-office value is
# empty. This is the current demo route; API keys must be supplied locally.
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_PROVIDER_PREFS=only=deepseek,cloudflare,order=deepseek,cloudflare,require_parameters=true
LLM_TIMEOUT_SECONDS=600
LLM_MAX_ATTEMPTS=2
LLM_JOB_MODEL_BUDGET_SECONDS=600
LLM_TEMPERATURE=0
# Leave empty to use the model default for extraction and comparison.
# Set an explicit effort only when needed. Office-prefixed overrides are supported.
LLM_REASONING_EFFORT=
# json_schema asks the provider to enforce the schema. json_object includes the
# same schema in the prompt and enforces it in the backend; this allows providers
# such as DeepSeek that offer JSON mode but not strict structured output.
LLM_RESPONSE_FORMAT=json_object
# Only approve an office-controlled private/loopback model endpoint. Restart both
# office and frontend servers; office-prefixed overrides are supported.
LLM_LOCAL_ENDPOINT_APPROVED=0

# General policy retrieval/comparison. Same office-prefixed overrides are supported.
# These bound candidates/calls; skipped coverage is exposed as needs_review.
POLICY_COMPARISON_TOP_K=6
POLICY_COMPARISON_MAX_PAIRS=24

# --------------------------------------------------------------- shared local URLs
DHAKA_BASE_URL=http://127.0.0.1:8081
FRANKFURT_BASE_URL=http://127.0.0.1:8082
GATEWAY_BASE_URL=http://127.0.0.1:8080

# Browser accounts bootstrap admin/admin once; manage privileges in Users.
# Optional account database and delegation key locations (defaults shown).
# The frontend and all backends must use the same delegation key.
# UI_AUTH_DB_PATH=runtime/ui/accounts.sqlite
# UI_AUTH_KEY_PATH=runtime/auth-bridge/key
# Built server port; the Vite dev server uses 5173.
UI_PORT=5173

# trusted key registry produced by `make setup` (public keys only)
TRUSTED_KEYS_PATH=runtime/trusted_keys.json

# ------------------------------------------------------------------ demo identities
# Bearer tokens for the static demo identity map.  Values are secrets: keep them out
# of version control and screenshots.
DEMO_TOKEN_DHAKA_UPLOADER=
DEMO_TOKEN_FRANKFURT_UPLOADER=
DEMO_TOKEN_DHAKA_REVIEWER=
DEMO_TOKEN_FRANKFURT_REVIEWER=
DEMO_TOKEN_DHAKA_READER=
DEMO_TOKEN_FRANKFURT_READER=
DEMO_TOKEN_GATEWAY_SERVICE=
DEMO_TOKEN_DHAKA_SERVICE=
DEMO_TOKEN_FRANKFURT_SERVICE=

# ------------------------------------------------------------------------ playback
# replay|cached|live. API requests that omit mode use DEFAULT_MODE.
# Browser PDF/Slack uploads explicitly request live; seed/demo scripts use
# DEMO_EXTRACTION_MODE unless their command supplies --mode.
DEFAULT_MODE=replay
DEMO_EXTRACTION_MODE=replay
# set to 1 only for an explicitly requested paid live smoke test
ALLOW_PAID_LIVE_TESTS=0

# -------------------------------------------------------------------------- docker
# Container uid:gid. `make setup` records the current account so bind-mounted
# runtime files remain owned by the developer (and removable by reset-demo).
MERIDIAN_UID=1000
MERIDIAN_GID=1000

# Optional read-only live Slack connector. Use a separate Slack app per office.
# App-level token: connections:write; bot: channels:read, channels:history.
DHAKA_SLACK_APP_TOKEN=
DHAKA_SLACK_BOT_TOKEN=
FRANKFURT_SLACK_APP_TOKEN=
FRANKFURT_SLACK_BOT_TOKEN=
